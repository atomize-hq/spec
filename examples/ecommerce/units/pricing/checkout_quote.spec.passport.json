      }
    }
  },
  "constructors": [
    {
      "id": "new",
      "intent": {
        "why": "Create a quote from explicit subtotal and rates."
      },
      "contract": {
        "inputs": {
          "subtotal": "rust_decimal::Decimal",
          "discount_rate": "rust_decimal::Decimal",
          "tax_rate": "rust_decimal::Decimal"
        },
        "invariants": []
      },
      "initializes": {
        "subtotal": "subtotal",
        "discount_rate": "discount_rate",
        "tax_rate": "tax_rate"
      }
    }
  ],
  "methods": [
    {
      "id": "discounted_subtotal",
      "intent": {
        "why": "Return the discounted subtotal before tax."
      },
      "receiver": "shared_ref",
      "contract": {
        "returns": "rust_decimal::Decimal",
        "invariants": []
      },
      "deps": [
        "pricing/apply_discount"
      ],
      "lowering": {
        "rust": {
          "body": "{\n    apply_discount(self.subtotal, self.discount_rate)\n}\n"
        }
      }
    },
    {
      "id": "total",
      "intent": {
        "why": "Return the final checkout total after discount and tax."
      },
      "receiver": "shared_ref",
      "contract": {
        "returns": "rust_decimal::Decimal",
        "invariants": []
      },
      "deps": [
        "pricing/apply_tax"
      ],
      "lowering": {
        "rust": {
          "body": "{\n    apply_tax(self.discounted_subtotal(), self.tax_rate)\n}\n"
        }
      }
    }
  ],
  "backends": {
    "rust": {
      "derives": [
        "Clone",
