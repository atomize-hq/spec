{
  "spec_version": "0.3.0",
  "id": "pricing/discount_policy",
  "kind": "sum",
  "intent": "Represent mutually exclusive discount strategies for checkout pricing.",
  "sum": {
    "variants": {
      "none": {},
      "percentage": {
        "fields": {
          "rate": {
            "type": "rust_decimal::Decimal"
          }
        }
      },
      "fixed_amount": {
        "fields": {
          "amount": {
            "type": "rust_decimal::Decimal"
          }
        }
      }
    }
  },
  "methods": [
    {
      "id": "discount_amount",
      "intent": {
        "why": "Return the discount amount to subtract from the subtotal."
      },
      "receiver": "shared_ref",
      "contract": {
        "inputs": {
          "subtotal": "rust_decimal::Decimal"
        },
        "returns": "rust_decimal::Decimal",
        "invariants": []
      },
      "deps": [],
      "lowering": {
        "rust": {
          "body": "{\n    match self {\n        Self::None => rust_decimal::Decimal::ZERO,\n        Self::Percentage { rate } => subtotal * *rate,\n        Self::FixedAmount { amount } => (*amount).min(subtotal),\n    }\n}\n"
        }
      }
    },
    {
      "id": "discounted_subtotal",
      "intent": {
        "why": "Return the subtotal after applying the selected discount strategy."
      },
      "receiver": "shared_ref",
      "contract": {
        "inputs": {
          "subtotal": "rust_decimal::Decimal"
        },
        "returns": "rust_decimal::Decimal",
        "invariants": []
      },
      "deps": [],
      "lowering": {
        "rust": {
          "body": "{\n    subtotal - self.discount_amount(subtotal)\n}\n"
        }
      }
    },
    {
      "id": "percentage_example_holds",
      "intent": {
        "why": "Support direct atom proof for the canonical percentage discount example."
      },
      "receiver": "shared_ref",
      "contract": {
        "returns": "bool",
        "invariants": []
      },
      "deps": [],
      "lowering": {
        "rust": {
          "body": "{\n    let policy = Self::Percentage {\n        rate: rust_decimal::Decimal::new(10, 2),\n    };\n    policy.discount_amount(rust_decimal::Decimal::new(10000, 2))\n        == rust_decimal::Decimal::new(1000, 2)\n        && policy.discounted_subtotal(rust_decimal::Decimal::new(10000, 2))\n            == rust_decimal::Decimal::new(9000, 2)\n}\n"
        }
      }
    },
    {
      "id": "fixed_amount_example_holds",
      "intent": {
        "why": "Support direct atom proof for the canonical fixed-amount discount example."
      },
      "receiver": "shared_ref",
      "contract": {
        "returns": "bool",
        "invariants": []
      },
      "deps": [],
      "lowering": {
        "rust": {
          "body": "{\n    let policy = Self::FixedAmount {\n        amount: rust_decimal::Decimal::new(1250, 2),\n    };\n    policy.discount_amount(rust_decimal::Decimal::new(5000, 2))\n        == rust_decimal::Decimal::new(1250, 2)\n        && policy.discounted_subtotal(rust_decimal::Decimal::new(5000, 2))\n            == rust_decimal::Decimal::new(3750, 2)\n}\n"
        }
      }
    },
    {
      "id": "fixed_amount_capped_behavior_holds",
      "intent": {
        "why": "Support direct atom proof for capped fixed-amount discount behavior."
      },
      "receiver": "shared_ref",
      "contract": {
        "returns": "bool",
        "invariants": []
      },
      "deps": [],
      "lowering": {
        "rust": {
          "body": "{\n    let policy = Self::FixedAmount {\n        amount: rust_decimal::Decimal::new(2000, 2),\n    };\n    policy.discount_amount(rust_decimal::Decimal::new(1500, 2))\n        == rust_decimal::Decimal::new(1500, 2)\n        && policy.discounted_subtotal(rust_decimal::Decimal::new(1500, 2))\n            == rust_decimal::Decimal::ZERO\n}\n"
        }
      }
    }
  ],
  "backends": {
    "rust": {
      "derives": [
        "Clone",
        "Debug",
        "PartialEq"
      ]
    }
  },
  "deps": [],
  "local_tests": [
    {
      "id": "variant_none",
      "expect": "DiscountPolicy::None.discount_amount(rust_decimal::Decimal::new(1500, 2)) == rust_decimal::Decimal::ZERO && DiscountPolicy::None.discounted_subtotal(rust_decimal::Decimal::new(1500, 2)) == rust_decimal::Decimal::new(1500, 2)"
    },
    {
      "id": "variant_percentage",
      "expect": "DiscountPolicy::None.percentage_example_holds()"
    },
    {
