  ],
  "local_tests": [
    {
      "id": "discounted_subtotal_basic",
      "expect": "PricingQuote::new(rust_decimal::Decimal::new(10000, 2), rust_decimal::Decimal::new(10, 2), rust_decimal::Decimal::new(5, 2)).discounted_subtotal() == rust_decimal::Decimal::new(9000, 2)"
