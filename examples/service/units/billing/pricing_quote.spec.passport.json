{
  "spec_version": "0.3.0",
  "id": "billing/pricing_quote",
  "kind": "data",
  "intent": "Quote a service checkout total from subtotal plus membership discount and regional fee rates.",
  "data": {
    "fields": {
      "subtotal": {
        "type": "rust_decimal::Decimal"
      },
