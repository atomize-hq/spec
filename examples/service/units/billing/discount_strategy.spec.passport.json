{
  "spec_version": "0.3.0",
  "id": "billing/discount_strategy",
  "kind": "sum",
  "intent": "Represent mutually exclusive membership discount strategies for a service checkout flow.",
  "sum": {
    "variants": {
      "declined": {},
      "percentage": {
        "fields": {
          "rate": {
            "type": "rust_decimal::Decimal"
          }
        }
      },
      "fixed_credit": {
        "fields": {
          "amount": {
            "type": "rust_decimal::Decimal"
          }
        }
      }
    }
  },
  "methods": [
    {
      "id": "discount_amount",
      "intent": {
        "why": "Return the discount amount to subtract from the subtotal."
      },
      "receiver": "shared_ref",
      "contract": {
        "inputs": {
          "subtotal": "rust_decimal::Decimal"
        },
        "returns": "rust_decimal::Decimal",
        "invariants": []
      },
      "deps": [],
      "lowering": {
        "rust": {
          "body": "{\n    match self {\n        Self::Declined => rust_decimal::Decimal::ZERO,\n        Self::Percentage { rate } => subtotal * *rate,\n        Self::FixedCredit { amount } => (*amount).min(subtotal),\n    }\n}\n"
        }
      }
    },
    {
      "id": "discounted_subtotal",
      "intent": {
        "why": "Return the subtotal after applying the selected discount strategy."
      },
      "receiver": "shared_ref",
      "contract": {
        "inputs": {
          "subtotal": "rust_decimal::Decimal"
        },
        "returns": "rust_decimal::Decimal",
        "invariants": []
      },
      "deps": [],
      "lowering": {
        "rust": {
          "body": "{\n    subtotal - self.discount_amount(subtotal)\n}\n"
        }
      }
    },
    {
      "id": "declined_example_holds",
      "intent": {
        "why": "Support direct atom proof for the canonical declined-discount example."
      },
      "receiver": "shared_ref",
      "contract": {
        "returns": "bool",
        "invariants": []
      },
      "deps": [],
      "lowering": {
        "rust": {
          "body": "{\n    let policy = Self::Declined;\n    policy.discount_amount(rust_decimal::Decimal::new(10000, 2))\n        == rust_decimal::Decimal::ZERO\n        && policy.discounted_subtotal(rust_decimal::Decimal::new(10000, 2))\n            == rust_decimal::Decimal::new(10000, 2)\n}\n"
        }
      }
    },
    {
      "id": "percentage_example_holds",
      "intent": {
        "why": "Support direct atom proof for the canonical percentage discount example."
      },
      "receiver": "shared_ref",
      "contract": {
        "returns": "bool",
        "invariants": []
      },
      "deps": [],
      "lowering": {
        "rust": {
          "body": "{\n    let policy = Self::Percentage {\n        rate: rust_decimal::Decimal::new(10, 2),\n    };\n    policy.discount_amount(rust_decimal::Decimal::new(10000, 2))\n        == rust_decimal::Decimal::new(1000, 2)\n        && policy.discounted_subtotal(rust_decimal::Decimal::new(10000, 2))\n            == rust_decimal::Decimal::new(9000, 2)\n}\n"
        }
      }
    },
    {
      "id": "fixed_credit_capped_behavior_holds",
      "intent": {
        "why": "Support direct atom proof for capped fixed-credit behavior."
      },
      "receiver": "shared_ref",
      "contract": {
        "returns": "bool",
        "invariants": []
      },
      "deps": [],
      "lowering": {
        "rust": {
          "body": "{\n    let policy = Self::FixedCredit {\n        amount: rust_decimal::Decimal::new(2000, 2),\n    };\n    policy.discount_amount(rust_decimal::Decimal::new(1500, 2))\n        == rust_decimal::Decimal::new(1500, 2)\n        && policy.discounted_subtotal(rust_decimal::Decimal::new(1500, 2))\n            == rust_decimal::Decimal::ZERO\n}\n"
        }
      }
    }
  ],
  "backends": {
    "rust": {
      "derives": [
        "Clone",
        "Debug",
        "PartialEq"
      ]
    }
  },
  "deps": [],
