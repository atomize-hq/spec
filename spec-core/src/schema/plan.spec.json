{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "intent", "changes"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["why"],
      "properties": {
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit", "action", "acceptance"],
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": ["add", "modify", "remove"]
          },
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "validate": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "molecule_tests": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
