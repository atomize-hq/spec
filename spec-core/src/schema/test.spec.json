{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "test.spec",
  "description": "Schema for .test.spec molecule test files",
  "type": "object",
  "required": ["id", "intent", "body"],
  "additionalProperties": false,
  "definitions": {
    "import_path": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(::([a-zA-Z_][a-zA-Z0-9_]*))+$"
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*/[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)*$",
      "description": "Hierarchical molecule test ID. Must have at least one '/'. Each segment must be a valid Rust identifier (no keywords)."
    },
    "intent": {
      "type": "object",
      "required": ["why"],
      "additionalProperties": false,
      "properties": {
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[a-z][a-z0-9_]*::)?[a-z][a-z0-9_]*/[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)*$"
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/import_path"
      }
    },
    "body": {
      "type": "object",
      "required": ["rust"],
      "additionalProperties": false,
      "properties": {
        "rust": {
          "type": "string",
          "minLength": 1,
          "description": "A Rust block expression (syn::Block) starting with `{`. Must include outer braces."
        }
      }
    },
    "spec_version": {
      "type": "string",
      "description": "The spec format version this molecule test was authored for. Use full semver: \"0.3.0\".",
      "examples": ["0.3.0"]
    }
  }
}
